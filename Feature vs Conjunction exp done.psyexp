        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="0.5" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="+" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as random from 'random';&amp;#10;import * as math from 'math';&amp;#10;shape_size = 0.05;&amp;#10;search_stimuli = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="import * as random from 'random';&amp;#10;search_stimuli = [];&amp;#10;n_items = Number.parseInt(setSize);&amp;#10;present = Number.parseInt(targetPresent);&amp;#10;condition = searchType.toString();&amp;#10;positions = [];&amp;#10;while ((positions.length &lt; n_items)) {&amp;#10;    x = Math.random.uniform((- 0.7), 0.7);&amp;#10;    y = Math.random.uniform((- 0.45), 0.45);&amp;#10;    valid = true;&amp;#10;    for (var pos, _pj_c = 0, _pj_a = positions, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        pos = _pj_a[_pj_c];&amp;#10;        if (((Math.abs((x - pos[0])) &lt; 0.12) &amp;&amp; (Math.abs((y - pos[1])) &lt; 0.12))) {&amp;#10;            valid = false;&amp;#10;            break;&amp;#10;        }&amp;#10;    }&amp;#10;    if (valid) {&amp;#10;        positions.push([x, y]);&amp;#10;    }&amp;#10;}&amp;#10;if ((condition === &quot;feature&quot;)) {&amp;#10;    if ((present === 1)) {&amp;#10;        target_position = Math.random.randrange(n_items);&amp;#10;        for (var i, _pj_c = 0, _pj_a = util.range(n_items), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;            i = _pj_a[_pj_c];&amp;#10;            if ((i === target_position)) {&amp;#10;                shape = new visual.Circle(psychoJS.window, {&quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;red&quot;, &quot;lineColor&quot;: &quot;red&quot;, &quot;pos&quot;: positions[i]});&amp;#10;            } else {&amp;#10;                shape = new visual.Circle(psychoJS.window, {&quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;blue&quot;, &quot;lineColor&quot;: &quot;blue&quot;, &quot;pos&quot;: positions[i]});&amp;#10;            }&amp;#10;            search_stimuli.push(shape);&amp;#10;        }&amp;#10;    } else {&amp;#10;        for (var i, _pj_c = 0, _pj_a = util.range(n_items), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;            i = _pj_a[_pj_c];&amp;#10;            shape = new visual.Circle(psychoJS.window, {&quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;blue&quot;, &quot;lineColor&quot;: &quot;blue&quot;, &quot;pos&quot;: positions[i]});&amp;#10;            search_stimuli.push(shape);&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((condition === &quot;conjunction&quot;)) {&amp;#10;        if ((present === 1)) {&amp;#10;            target_position = Math.random.randrange(n_items);&amp;#10;            for (var i, _pj_c = 0, _pj_a = util.range(n_items), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;                i = _pj_a[_pj_c];&amp;#10;                if ((i === target_position)) {&amp;#10;                    shape = new visual.Circle(psychoJS.window, {&quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;red&quot;, &quot;lineColor&quot;: &quot;red&quot;, &quot;pos&quot;: positions[i]});&amp;#10;                } else {&amp;#10;                    if (Math.random.choice([true, false])) {&amp;#10;                        shape = new visual.Polygon(psychoJS.window, {&quot;edges&quot;: 3, &quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;red&quot;, &quot;lineColor&quot;: &quot;red&quot;, &quot;pos&quot;: positions[i]});&amp;#10;                    } else {&amp;#10;                        shape = new visual.Circle(psychoJS.window, {&quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;blue&quot;, &quot;lineColor&quot;: &quot;blue&quot;, &quot;pos&quot;: positions[i]});&amp;#10;                    }&amp;#10;                }&amp;#10;                search_stimuli.push(shape);&amp;#10;            }&amp;#10;        } else {&amp;#10;            for (var i, _pj_c = 0, _pj_a = util.range(n_items), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;                i = _pj_a[_pj_c];&amp;#10;                if (Math.random.choice([true, false])) {&amp;#10;                    shape = new visual.Polygon(psychoJS.window, {&quot;edges&quot;: 3, &quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;red&quot;, &quot;lineColor&quot;: &quot;red&quot;, &quot;pos&quot;: positions[i]});&amp;#10;                } else {&amp;#10;                    shape = new visual.Circle(psychoJS.window, {&quot;radius&quot;: 0.05, &quot;fillColor&quot;: &quot;blue&quot;, &quot;lineColor&quot;: &quot;blue&quot;, &quot;pos&quot;: positions[i]});&amp;#10;                }&amp;#10;                search_stimuli.push(shape);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="import random&amp;#10;&amp;#10;search_stimuli = []&amp;#10;&amp;#10;n_items = int(setSize)&amp;#10;present = str(targetPresence).strip().lower() in ['present', '1']&amp;#10;condition = str(searchType).strip().lower()&amp;#10;correct_answer='p' if present else 'a'&amp;#10;&amp;#10;positions = []&amp;#10;&amp;#10;while len(positions) &lt; n_items:&amp;#10;    x = random.uniform(-0.7, 0.7)&amp;#10;    y = random.uniform(-0.45, 0.45)&amp;#10;&amp;#10;    valid = True&amp;#10;&amp;#10;    for pos in positions:&amp;#10;        if abs(x - pos[0]) &lt; 0.12 and abs(y - pos[1]) &lt; 0.12:&amp;#10;            valid = False&amp;#10;            break&amp;#10;&amp;#10;    if valid:&amp;#10;        positions.append((x, y))&amp;#10;&amp;#10;if condition == 'feature':&amp;#10;&amp;#10;    if present == 1:&amp;#10;&amp;#10;        target_position = random.randrange(n_items)&amp;#10;&amp;#10;        for i in range(n_items):&amp;#10;&amp;#10;            if i == target_position:&amp;#10;                shape = visual.Circle(&amp;#10;                    win,&amp;#10;                    radius=0.05,&amp;#10;                    fillColor='red',&amp;#10;                    lineColor='red',&amp;#10;                    pos=positions[i]&amp;#10;                )&amp;#10;            else:&amp;#10;                shape = visual.Circle(&amp;#10;                    win,&amp;#10;                    radius=0.05,&amp;#10;                    fillColor='blue',&amp;#10;                    lineColor='blue',&amp;#10;                    pos=positions[i]&amp;#10;                )&amp;#10;&amp;#10;            search_stimuli.append(shape)&amp;#10;&amp;#10;    else:&amp;#10;&amp;#10;        for i in range(n_items):&amp;#10;&amp;#10;            shape = visual.Circle(&amp;#10;                win,&amp;#10;                radius=0.05,&amp;#10;                fillColor='blue',&amp;#10;                lineColor='blue',&amp;#10;                pos=positions[i]&amp;#10;            )&amp;#10;&amp;#10;            search_stimuli.append(shape)&amp;#10;&amp;#10;&amp;#10;elif condition == 'conjunction':&amp;#10;&amp;#10;    if present == 1:&amp;#10;&amp;#10;        target_position = random.randrange(n_items)&amp;#10;&amp;#10;        for i in range(n_items):&amp;#10;&amp;#10;            if i == target_position:&amp;#10;&amp;#10;                shape = visual.Circle(&amp;#10;                    win,&amp;#10;                    radius=0.05,&amp;#10;                    fillColor='red',&amp;#10;                    lineColor='red',&amp;#10;                    pos=positions[i]&amp;#10;                )&amp;#10;&amp;#10;            else:&amp;#10;&amp;#10;                if random.choice([True, False]):&amp;#10;&amp;#10;                    shape = visual.Polygon(&amp;#10;                        win,&amp;#10;                        edges=3,&amp;#10;                        radius=0.05,&amp;#10;                        fillColor='red',&amp;#10;                        lineColor='red',&amp;#10;                        pos=positions[i]&amp;#10;                    )&amp;#10;&amp;#10;                else:&amp;#10;&amp;#10;                    shape = visual.Circle(&amp;#10;                        win,&amp;#10;                        radius=0.05,&amp;#10;                        fillColor='blue',&amp;#10;                        lineColor='blue',&amp;#10;                        pos=positions[i]&amp;#10;                    )&amp;#10;&amp;#10;            search_stimuli.append(shape)&amp;#10;&amp;#10;    else:&amp;#10;&amp;#10;        for i in range(n_items):&amp;#10;&amp;#10;            if random.choice([True, False]):&amp;#10;&amp;#10;                shape = visual.Polygon(&amp;#10;                    win,&amp;#10;                    edges=3,&amp;#10;                    radius=0.05,&amp;#10;                    fillColor='red',&amp;#10;                    lineColor='red',&amp;#10;                    pos=positions[i]&amp;#10;                )&amp;#10;&amp;#10;            else:&amp;#10;&amp;#10;                shape = visual.Circle(&amp;#10;                    win,&amp;#10;                    radius=0.05,&amp;#10;                    fillColor='blue',&amp;#10;                    lineColor='blue',&amp;#10;                    pos=positions[i]&amp;#10;                )&amp;#10;&amp;#10;            search_stimuli.append(shape)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="for shape in search_stimuli:&amp;#10;    shape.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="for (var shape, _pj_c = 0, _pj_a = search_stimuli, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    shape = _pj_a[_pj_c];&amp;#10;    shape.draw();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;search_type&quot;, current_search_type);&amp;#10;psychoJS.experiment.addData(&quot;display_size&quot;, current_display_size);&amp;#10;psychoJS.experiment.addData(&quot;target_presence&quot;, current_target_presence);&amp;#10;psychoJS.experiment.addData(&quot;correct_answer&quot;, correct_answer);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if response.keys == correct_answer:&amp;#10;    correct = 1&amp;#10;else:&amp;#10;    correct = 0&amp;#10;&amp;#10;thisExp.addData('search_type', condition)&amp;#10;thisExp.addData('display_size', n_items)&amp;#10;thisExp.addData('target_presence', targetPresence)&amp;#10;thisExp.addData('correct_answer', correct_answer)&amp;#10;thisExp.addData('participant_response', response.keys)&amp;#10;thisExp.addData('correct', correct)&amp;#10;thisExp.addData('rt', response.rt)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <KeyboardComponent name="response" plugin="None">
