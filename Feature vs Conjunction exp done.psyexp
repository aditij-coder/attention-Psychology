  <Flow>
    <Routine name="Instructions"/>
    <Routine name="practice_instructions"/>
    <LoopInitiator loopType="TrialHandler" name="practice_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'searchType': 'feature', 'setSize': 1, 'targetPresence': 'present'}, {'searchType': 'feature', 'setSize': 1, 'targetPresence': 'absent'}, {'searchType': 'feature', 'setSize': 5, 'targetPresence': 'present'}, {'searchType': 'feature', 'setSize': 5, 'targetPresence': 'absent'}, {'searchType': 'feature', 'setSize': 15, 'targetPresence': 'present'}, {'searchType': 'feature', 'setSize': 15, 'targetPresence': 'absent'}, {'searchType': 'feature', 'setSize': 30, 'targetPresence': 'present'}, {'searchType': 'feature', 'setSize': 30, 'targetPresence': 'absent'}, {'searchType': 'conjunction', 'setSize': 1, 'targetPresence': 'present'}, {'searchType': 'conjunction', 'setSize': 1, 'targetPresence': 'absent'}, {'searchType': 'conjunction', 'setSize': 5, 'targetPresence': 'present'}, {'searchType': 'conjunction', 'setSize': 5, 'targetPresence': 'absent'}, {'searchType': 'conjunction', 'setSize': 15, 'targetPresence': 'present'}, {'searchType': 'conjunction', 'setSize': 15, 'targetPresence': 'absent'}, {'searchType': 'conjunction', 'setSize': 30, 'targetPresence': 'present'}, {'searchType': 'conjunction', 'setSize': 30, 'targetPresence': 'absent'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="practice_trials 4.0.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="practice_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Main_trial"/>
    <LoopTerminator name="practice_loop"/>
    <Routine name="Main_Instructions"/>
